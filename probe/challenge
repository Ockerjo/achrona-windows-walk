#!/usr/bin/env bash
# ./challenge <id>   run one challenge's tests (see CHALLENGES.md)
# ./challenge all    a green/red line per challenge
# The first run asks for your team key once, like ./run (the kit download).
set -uo pipefail
cd "$(dirname "$0")"
# The kit needs Flutter 3.47 (.fvmrc); use fvm's pin when it is installed.
flutter() { if command -v fvm >/dev/null; then fvm flutter "$@"; else command flutter "$@"; fi; }
# The hosted kit's one-time team key (./run and ./challenge share this; kit/runners.py).
PUB_URL="http://127.0.0.1:8765/pub"
if grep -qF "hosted: $PUB_URL" pubspec.yaml && ! grep -qs '^  achrona_kit:' pubspec_overrides.yaml; then
  if ! flutter pub token list 2>/dev/null | grep -qF "$PUB_URL"; then
    echo "First run: the kit downloads from $PUB_URL with your team key (asked once)."
    read -r -s -p "Team key (htf-..., on your team card): " key; echo
    [ -n "$key" ] || { echo "no team key given: nothing downloaded"; exit 1; }
    printf '%s\n' "$key" | flutter pub token add "$PUB_URL" >/dev/null \
      || { unset key; echo "could not store the team key for $PUB_URL"; exit 1; }
    unset key
  fi
  log="$(mktemp)"; trap 'rm -f "$log"' EXIT
  if ! flutter pub get 2>&1 | tee "$log"; then
    if grep -qiE '401|403|authenticat' "$log"; then
      flutter pub token remove "$PUB_URL" >/dev/null 2>&1
      echo "The kit download was refused: check your team key (on your team card) or run Connect GitHub on your team page. The next ./run asks for the key again."
    fi
    exit 1
  fi
fi
run() {
  case "$1" in
  level-01) flutter test test/level_spec_test.dart test/level_reach_test.dart ;;
  base-01) flutter test test/challenges/base_01_camera_test.dart ;;
  base-02) flutter test test/challenges/base_02_facing_test.dart ;;
  build-01) flutter test test/challenges/build_01_feet_test.dart ;;
  build-02) flutter test test/challenges/build_02_lean_test.dart ;;
  online-01) flutter test test/run_link_test.dart --plain-name 'RunLink.submit' ;;
  bonus-01) flutter test test/challenges/bonus_01_platform_test.dart ;;
  bonus-02) flutter test test/challenges/bonus_02_door_test.dart ;;
  bonus-03) flutter test test/challenges/bonus_03_chase_test.dart ;;
  bonus-04) flutter test test/challenges/bonus_04_bounce_test.dart ;;
  bonus-05) flutter test test/challenges/bonus_05_checkpoint_test.dart ;;
  *) echo "unknown challenge: $1 (see CHALLENGES.md)"; return 2 ;;
  esac
}
if [ "${1:-}" = all ]; then
  reds=0
  for id in base-01 base-02 build-01 build-02 level-01 online-01 bonus-01 bonus-02 bonus-03 bonus-04 bonus-05; do
    if out=$(run "$id" 2>&1); then echo "GREEN $id"; else
      reds=$((reds + 1))
      # The first failing test's name, or the first compile error.
      why=$(printf '%s\n' "$out" | grep -m1 -E ' \[E\]$|Error: ' | sed -E 's/^[0-9:]+ [-+0-9 ]+: //; s/ \[E\]$//')
      echo "red   $id${why:+   ($why)}"
    fi
  done
  [ "$reds" -gt 0 ] && echo "A red one? Run ./challenge <id> to see why (e.g. ./challenge base-01)."
else
  run "${1:?usage: ./challenge <id>|all}"
fi
